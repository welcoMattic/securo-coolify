# Variables d'environnement optionnelles pour Securo sur Coolify.
# À renseigner dans l'onglet "Environment Variables" de la ressource Coolify,
# uniquement celles dont vous avez besoin. Ce fichier n'est pas lu par Coolify.
#
# Générées automatiquement par Coolify, NE PAS définir ici :
#   SERVICE_PASSWORD_64_SECRETKEY  clé secrète du backend (SECRET_KEY)
#   SERVICE_PASSWORD_POSTGRES      mot de passe PostgreSQL
#   SERVICE_URL_FRONTEND           URL publique https (FRONTEND_URL), dérivée du domaine du frontend
#   SERVICE_FQDN_FRONTEND_8080     routage du proxy Coolify vers le frontend

# --- Version -----------------------------------------------------------------
# Tag des images ghcr.io/securo-finance/securo-backend et securo-frontend (sans préfixe "v")
SECURO_VERSION=0.15.1

# --- Pluggy (agrégation bancaire, https://dashboard.pluggy.ai) ---------------
# Callback à autoriser côté Pluggy : ${FRONTEND_URL}/oauth/callback
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# À définir seulement si l'URL enregistrée chez Pluggy diffère du callback ci-dessus
PLUGGY_OAUTH_REDIRECT_URI=

# --- Enable Banking (banques européennes, https://enablebanking.com) ---------
# Callback à autoriser côté Enable Banking : ${FRONTEND_URL}/oauth/callback
ENABLE_BANKING_APP_ID=
# Clé privée PEM brute, retours à la ligne échappés en \n (remplace le fichier ./secrets upstream)
# Exemple : -----BEGIN PRIVATE KEY-----\nMIIEvg...\n-----END PRIVATE KEY-----
ENABLE_BANKING_PRIVATE_KEY=
ENABLE_BANKING_OAUTH_REDIRECT_URI=
ENABLE_BANKING_API_URL=https://api.enablebanking.com

# --- SimpleFIN Bridge (US) ---------------------------------------------------
SIMPLEFIN_ENABLED=false
# Passer à https://bridge.simplefin.org en production
SIMPLEFIN_API_URL=https://beta-bridge.simplefin.org

# --- OIDC (Authentik, Pocket ID, tout fournisseur standard) ------------------
# Callback à enregistrer chez le fournisseur : ${FRONTEND_URL}/api/auth/oidc/callback
OIDC_ENABLED=false
OIDC_PROVIDER_NAME=OIDC
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid email profile
OIDC_AUTO_REGISTER=true
# disabled (jamais), verified_email (si email_verified=true), email (sur simple correspondance d'email)
OIDC_EXISTING_USER_LINK_MODE=disabled
OIDC_REQUIRE_VERIFIED_EMAIL=true
OIDC_SYNC_ROLES=false
OIDC_ROLES_CLAIM=groups
OIDC_ADMIN_ROLES=
# Exemple : {"securo-owners":"owner","securo-editors":"editor","securo-viewers":"viewer"}
OIDC_WORKSPACE_ROLE_MAP=

# --- Authentification locale -------------------------------------------------
# false = connexion OIDC uniquement (désactive inscription, mot de passe et nouvelles passkeys)
LOCAL_AUTH_ENABLED=true

# --- Taux de change ----------------------------------------------------------
OPENEXCHANGERATES_APP_ID=
# on_demand ou scheduled
FX_SYNC_MODE=on_demand

# --- Tesouro Direto (obligations brésiliennes) -------------------------------
TESOURO_DIRETO_ENABLED=false

# --- Passkeys (WebAuthn) -----------------------------------------------------
# Laisser vide : suit le domaine du navigateur. Renseigner le domaine parent si plusieurs sous-domaines.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=Securo

# --- Proxy -------------------------------------------------------------------
# coolify-proxy (Traefik) + nginx du frontend = 2 sauts de confiance
TRUSTED_PROXY_HOPS=2
